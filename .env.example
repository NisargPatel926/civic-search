# ---------------------------------------------------------------------------
# Civic Search — environment configuration
# Copy to `.env` (never commit it) and fill in what you have.
# Every key is optional: anything missing falls back to clearly-labeled
# sample data so the app still runs end to end.
# ---------------------------------------------------------------------------

PORT=3000

# Articles — https://newsapi.org/register  (free developer tier)
# Required for live articles. Without it the Articles column shows SAMPLE cards.
NEWS_API_KEY=

# Federal bills + laws — https://api.data.gov/signup (Congress.gov API)
CONGRESS_GOV_API_KEY=

# State (and some local) bills + legislators — https://open.pluralpolicy.com/accounts/profile/
OPENSTATES_API_KEY=

# Optional: how long upstream responses are cached, in seconds.
CACHE_TTL_SECONDS=900

# Optional: NewsAPI developer accounts cannot query further back than ~30 days.
# Set to 0 to let the UI request any range anyway.
NEWS_MAX_LOOKBACK_DAYS=30
